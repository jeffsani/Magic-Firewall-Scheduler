{
  "name": "worker-mfw-automation",
  "version": "1.0.0",
  "private": true,
  "description": "Magic Firewall Rule Scheduler — Cloudflare Worker with Web UI",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create mfw-automation-db",
    "db:init": "wrangler d1 execute mfw-automation-db --local --file=schema.sql",
    "db:init:remote": "wrangler d1 execute mfw-automation-db --remote --file=schema.sql",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251120.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.93.1"
  }
}
