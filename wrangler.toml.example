name = "firewall-rule-scheduler"
main = "src/index.ts"
compatibility_date = "2025-11-17"
compatibility_flags = ["nodejs_compat"]

[vars]
# CF Access — set to your Access team name (e.g. "mycompany" for mycompany.cloudflareaccess.com)
# Set ENVIRONMENT to "development" to bypass auth during local dev
ENVIRONMENT = "production"
CF_ACCESS_TEAM_DOMAIN = "YOUR_ACCESS_TEAM_NAME"

[triggers]
# Cron Trigger: Runs every 15 minutes to check the state of the target rules
crons = [ "*/15 * * * *" ]

[[d1_databases]]
binding = "DB"
database_name = "mfw-automation-db"
# Replace with your D1 database ID after running: npx wrangler d1 create mfw-automation-db
database_id = "YOUR_D1_DATABASE_ID"

[placement]
mode = "smart"

[observability]
enabled = true
head_sampling_rate = 1

[observability.logs]
enabled = true
head_sampling_rate = 1
persist = true
invocation_logs = true
